# Local development credentials only. Never reuse them outside an isolated demo.
DATABASE_URL=postgresql://tournament:tournament@localhost:55432/tournament
RABBITMQ_URL=amqp://tournament:tournament@localhost:5673
PORT=3000
# USD value of one currency unit. These are illustrative fixed rates, not live quotes.
FX_RATES={"USD":"1","EUR":"1.10","GBP":"1.25"}
QUEUE_PREFIX=tournament
PREFETCH=16
MAX_RETRIES=5
RETRY_DELAY_MS=1000

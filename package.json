{
  "name": "betting-tournament",
  "version": "1.0.0",
  "private": true,
  "description": "Betting tournament: NestJS, PostgreSQL and RabbitMQ",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:dev": "npm run build && npm start",
    "migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "produce": "node --env-file-if-exists=.env dist/scripts/produce.js",
    "test": "npm run build && node --test dist/test/unit/*.test.js",
    "test:integration": "npm run build && node --env-file-if-exists=.env --test --test-concurrency=1 dist/test/integration/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "amqp-connection-manager": "5.0.1",
    "amqplib": "2.2.1",
    "decimal.js": "10.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
